# ============================================================
# PUCHO — environment configuration
# Copy this file to `.env` and fill in your AI provider credentials.
# `.env` is git-ignored and is only ever read by the server process.
# ============================================================

# ---------- Provider API key (required) ----------
# Your AI provider API key. Server-side only: it never reaches the browser.
GROQ_API_KEY=

# OpenAI-compatible endpoint for the provider.
GROQ_API_URL=https://api.example-provider.example/v1

# ---------- Models ----------
# Leave a value blank to let PUCHO auto-select a model your key can reach.
# If your provider account only has one model, set GROQ_MODEL and PUCHO will
# use it for every mode.

# One model for all modes (optional shortcut).
GROQ_MODEL=

# Per-mode overrides (optional).
GROQ_MODEL_FAST=
GROQ_MODEL_THINK=
GROQ_MODEL_CODE=
GROQ_MODEL_STUDY=
GROQ_MODEL_RESEARCH=

# Optional: a vision-capable model used when images are attached.
GROQ_MODEL_VISION=

# Max tokens per answer and request timeout.
GROQ_MAX_TOKENS=4096
GROQ_TIMEOUT_MS=180000

# ---------- Server ----------
NODE_ENV=development
PORT=8787
HOST=127.0.0.1
DATA_DIR=data

# Comma-separated list of extra origins allowed to call the API.
# ALLOWED_ORIGINS=https://pucho.example.com

# ---------- Persistence (required on Vercel) ----------
# Locally PUCHO keeps conversations in `data/pucho.db` via `node:sqlite`.
# Vercel functions have no persistent disk, so point PUCHO at a remote
# libSQL / Turso database. When TURSO_DATABASE_URL is set the same SQL runs
# against Turso instead, and the local file is ignored.
# TURSO_DATABASE_URL=libsql://your-db-your-org.turso.io
# TURSO_AUTH_TOKEN=

# Uploaded file bytes. Local disk by default; on Vercel set a Vercel Blob
# token so uploads land in object storage instead of an ephemeral disk.
# BLOB_READ_WRITE_TOKEN=

# ---------- Web research (optional) ----------
# RESEARCH mode uses a real search provider when one is configured, and tells
# the user honestly when it is not. Add one key to enable live sources.
# WEB_SEARCH_PROVIDER=
TAVILY_API_KEY=
SERPER_API_KEY=
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=6

# ---------- Speech (optional) ----------
# PUCHO always can read answers aloud using the browser's own voices.
# Configure these only if you want server-generated audio.
# TTS_PROVIDER=openai
TTS_API_KEY=
TTS_MODEL=gpt-4o-mini-tts
TTS_VOICE=alloy

# ---------- Limits ----------
MAX_FILE_BYTES=20971520
MAX_IMAGE_BYTES=8388608
MAX_MESSAGE_CHARS=32000
RATE_LIMIT_CHAT=45
RATE_LIMIT_UPLOAD=20
