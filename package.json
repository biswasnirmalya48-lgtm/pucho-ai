{
  "name": "pucho-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "PUCHO — Bas Pucho. A fast, intelligent, friendly AI assistant powered by GROQ.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite --config client/vite.config.ts",
    "build": "vite build --config client/vite.config.ts",
    "start": "NODE_ENV=production node server/index.js",
    "serve": "npm run build && npm start",
    "test": "node --test \"tests/**/*.test.js\"",
    "typecheck": "tsc -p client/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "@vercel/blob": "^2.8.0",
    "dotenv": "^16.4.5",
    "express": "^5.2.1",
    "highlight.js": "^11.10.0",
    "katex": "^0.16.10",
    "lucide-react": "^0.451.0",
    "mammoth": "^1.8.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^4.6.82",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "concurrently": "^9.0.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.8"
  }
}
